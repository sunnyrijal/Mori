# ─────────────────────────────────────────────
# Life Companion — Environment Variables
# Copy this file to .env and fill in your keys
# ─────────────────────────────────────────────

# ── AI (Google Gemini) ──────────────────────
# Get your key at https://aistudio.google.com/apikey
# When set, the AI suggestion engine and chat will activate automatically.
# Leave empty or set to "paused" to keep using the local suggestion engine.
GEMINI_API_KEY=

# ── Supabase (Authentication & DB) ───────────
# Get your keys at https://supabase.com/dashboard/project/.../settings/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── RevenueCat (Mobile Subscriptions) ──────
VITE_REVENUECAT_APPLE_KEY=
VITE_REVENUECAT_GOOGLE_KEY=

# ── Google OAuth (Sign In with Google) ──────
# Create a project at https://console.cloud.google.com
# → APIs & Services → Credentials → Create OAuth 2.0 Client ID
# Set Authorized JavaScript origins to your domain (e.g. http://localhost:5000)
VITE_GOOGLE_CLIENT_ID=

# ── Firebase (Push Notifications) ───────────
# Create a project at https://console.firebase.google.com
# → Project Settings → General → Your apps → Add app (Web)
# Copy the firebaseConfig values below
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Cloud Messaging VAPID key for web push
# → Firebase Console → Project Settings → Cloud Messaging → Web Push certificates → Generate key pair
VITE_FIREBASE_VAPID_KEY=

# ── Database (PostgreSQL) ───────────────────
# Connection string for your PostgreSQL database
# Local: postgres://user:password@localhost:5432/lifecompanion
# Cloud: use Railway, Supabase, or Neon
DATABASE_URL=

# ── Stripe (Payments) ───────────────────────
# Dashboard: https://dashboard.stripe.com/test/apikeys
# Use test keys (sk_test_...) for development
STRIPE_SECRET_KEY=

# Get from: Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret
# For local dev, use: stripe listen --forward-to localhost:3001/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
