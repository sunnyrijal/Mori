# ─────────────────────────────────────────────
# Gozi Environment Variables
# Copy this file to .env and fill in your keys
# ─────────────────────────────────────────────

# =============================================
# FRONTEND VARIABLES (Vite / Client Application)
# =============================================

# ── Supabase (Client-Side Config) ───────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── RevenueCat (Mobile Subscriptions) ──────
VITE_REVENUECAT_APPLE_KEY=
VITE_REVENUECAT_GOOGLE_KEY=

# ── Google OAuth (Sign In with Google) ──────
VITE_GOOGLE_CLIENT_ID=

# ── Firebase (Push Notifications Config) ────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=


# =============================================
# BACKEND VARIABLES (Express Server / Services)
# =============================================

# ── AI (Google Gemini Backend Key) ───────────
# Get your key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Supabase (Service Role Admin Key) ────────
# Crucial for admin operations and backend database communication
SUPABASE_SERVICE_ROLE_KEY=

# ── Database (PostgreSQL URL fallback) ──────
DATABASE_URL=

# ── Stripe (Payments Backend Config) ─────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
